{
  "name": "@openpicker/sdk",
  "version": "0.2.2",
  "description": "Open-source CSS element picker — SDK for invoking the openpicker browser extension.",
  "license": "MIT",
  "author": "Usertour (https://www.usertour.io)",
  "homepage": "https://openpicker.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usertour/openpicker.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/usertour/openpicker/issues"
  },
  "keywords": [
    "openpicker",
    "element-picker",
    "css-selector",
    "selector",
    "picker",
    "browser-extension",
    "devtools",
    "dom"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@openpicker/protocol": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
