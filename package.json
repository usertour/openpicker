{
  "name": "openpicker-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:ext": "pnpm --filter @openpicker/extension dev",
    "dev:sdk": "pnpm --filter @openpicker/sdk dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "e2e": "node e2e/run.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:page": "pnpm --filter @openpicker/test dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.15",
      "@types/react-dom": "19.2.3"
    }
  }
}
