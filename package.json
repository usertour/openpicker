{
  "name": "openpicker-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:ext": "pnpm --filter @openpicker/extension dev",
    "dev:sdk": "pnpm --filter openpicker dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "e2e": "node e2e/run.mjs",
    "test:page": "node apps/test/serve.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.15",
      "@types/react-dom": "19.2.15"
    }
  }
}
